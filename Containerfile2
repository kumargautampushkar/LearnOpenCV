# Use NVIDIA's official CUDA base image (includes drivers/libraries)
# 'devel' is safer for compatibility; use 'runtime' for smaller size if compiling nothing
FROM docker.io/nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# Set non-interactive mode for apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Update system and install Python 3 + Pip
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create a working directory
WORKDIR /app

# Create a virtual environment (best practice for modern Python envs)
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install PyTorch with CUDA support
# NOTE: Ensure the 'cu121' matches the CUDA version compatible with your host driver
RUN pip3 install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

# Verify installation command
CMD ["python3", "-c", "import torch; print(f'PyTorch: {torch.__version__}'); print(f'CUDA Available: {torch.cuda.is_available()}'); print(f'Device Name: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"None\"}')"]